/* 创建付款页面样式 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 120rpx;
}

.form-container {
  background-color: #FFFFFF;
  margin: 24rpx 32rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

/* 表单项 */
.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.form-label.required::after {
  content: '*';
  color: #FF4D4F;
  margin-left: 8rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-input:focus {
  background-color: #FFFFFF;
  border-color: #52C41A;
}

/* 快捷金额列表 */
.quick-amount-list {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-amount-item {
  padding: 12rpx 24rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
  transition: all 0.3s;
}

.quick-amount-item:active {
  background-color: #F6FFED;
  color: #52C41A;
}

/* 选择器输入框 */
.picker-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-text {
  color: #333;
}

.picker-text.placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 40rpx;
  color: #999;
  transform: rotate(90deg);
}

/* 付款方式按钮 */
.payment-methods {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.method-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.method-btn:active {
  background-color: #E6F7FF;
}

.method-btn.active {
  background-color: #E6F7FF;
  border-color: #1890FF;
}

.method-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.method-text {
  font-size: 26rpx;
  color: #333;
}

.method-btn.active .method-text {
  color: #1890FF;
  font-weight: 500;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 24rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-textarea:focus {
  background-color: #FFFFFF;
  border-color: #52C41A;
}

/* 图片上传 */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: flex-start;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  background-color: #F5F7FA;
  border: 2rpx dashed #D9D9D9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.upload-btn:active {
  background-color: #E6F7FF;
  border-color: #1890FF;
}

.upload-icon {
  font-size: 64rpx;
  color: #999;
  line-height: 1;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #999;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  flex: 1;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.upload-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 付款预览 */
.payment-preview {
  margin-top: 32rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #F6FFED 0%, #D9F7BE 100%);
  border-radius: 12rpx;
  border: 2rpx solid #B7EB8F;
}

.preview-header {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed #B7EB8F;
}

.preview-title {
  font-size: 28rpx;
  color: #52C41A;
  font-weight: bold;
}

.preview-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.preview-label {
  font-size: 26rpx;
  color: #666;
}

.preview-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.preview-amount {
  font-size: 40rpx;
  color: #52C41A;
  font-weight: bold;
}

.preview-unpaid {
  font-size: 32rpx;
  color: #FAAD14;
  font-weight: bold;
}

/* 底部按钮 */
.footer-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.footer-buttons .btn {
  width: 48%;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
}
