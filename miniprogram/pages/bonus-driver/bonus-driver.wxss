/* 司机分红页面样式 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 20rpx;
}

.info-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 20rpx 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
}

.info-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
}

.driver-list {
  padding: 0 24rpx;
}

.driver-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.driver-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.driver-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.driver-count {
  font-size: 24rpx;
  color: #999;
}

.driver-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  align-items: baseline;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.stat-unit {
  font-size: 22rpx;
  color: #999;
  margin-left: 4rpx;
}

.primary-color {
  color: #1890FF;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.hint {
  font-size: 24rpx;
  margin-top: 8rpx;
}
