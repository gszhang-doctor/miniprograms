/* 工头分红页面样式 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 120rpx;
}

.info-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 20rpx 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
}

.info-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.info-detail {
  font-size: 28rpx;
  opacity: 0.9;
}

.record-list {
  padding: 0 24rpx;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-amount {
  display: flex;
  align-items: baseline;
}

.amount-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.amount-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.amount-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
}

.tag-success {
  background-color: #F6FFED;
  color: #52C41A;
  border: 1rpx solid #B7EB8F;
}

.tag-warning {
  background-color: #FFF7E6;
  color: #FA8C16;
  border: 1rpx solid #FFD591;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid #F0F0F0;
}

.record-creator {
  font-size: 22rpx;
  color: #999;
}

.delete-btn {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: #FFF1F0;
}

.delete-icon {
  font-size: 28rpx;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 32rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.hint {
  font-size: 24rpx;
  margin-top: 8rpx;
}
