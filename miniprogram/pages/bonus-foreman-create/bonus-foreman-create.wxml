<!-- 工头分红创建页面 -->
<view class="container">
  <view class="form-card">
    <view class="form-title">工头分红</view>

    <!-- 项目名称 -->
    <view class="form-item">
      <text class="form-label">项目名称</text>
      <view class="form-value">{{projectName}}</view>
    </view>

    <!-- 工头 -->
    <view class="form-item">
      <text class="form-label">工头</text>
      <view class="form-value">{{foreman}}</view>
    </view>

    <!-- 金额 -->
    <view class="form-item">
      <text class="form-label">金额</text>
      <view class="form-input-wrapper">
        <input
          class="form-input"
          type="digit"
          placeholder="请输入金额（选填）"
          value="{{amount}}"
          bindinput="inputAmount"
        />
        <text class="form-unit">元</text>
      </view>
    </view>

    <!-- 支付状态 -->
    <view class="form-item">
      <text class="form-label">是否已支付</text>
      <view class="radio-group">
        <label class="radio-item {{!paid ? 'active' : ''}}" bindtap="togglePaid" data-value="false">
          <view class="radio-icon {{!paid ? 'checked' : ''}}"></view>
          <text class="radio-text">否</text>
        </label>
        <label class="radio-item {{paid ? 'active' : ''}}" bindtap="togglePaid" data-value="true">
          <view class="radio-icon {{paid ? 'checked' : ''}}"></view>
          <text class="radio-text">是</text>
        </label>
      </view>
    </view>

    <!-- 创建者 -->
    <view class="form-item">
      <text class="form-label">创建者</text>
      <view class="form-value">{{creator || '未设置'}}</view>
    </view>
  </view>

  <!-- 按钮 -->
  <view class="btn-group">
    <button class="btn btn-preview" bindtap="preview">预览</button>
    <button class="btn btn-save" bindtap="save">确认保存</button>
  </view>
</view>
