/* 车次列表页面样式 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 120rpx;
}

/* 顶部信息 */
.header {
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  padding: 40rpx 32rpx;
  color: #FFFFFF;
}

.project-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.project-name {
  font-size: 36rpx;
  font-weight: bold;
}

.truck-count {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 统计卡片 */
.stats-card {
  background-color: #FFFFFF;
  margin: 24rpx 32rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stats-value {
  font-size: 48rpx;
  font-weight: bold;
}

.stats-unit {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stats-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: #F0F0F0;
}

/* 车次列表 */
.truck-list {
  padding: 0 32rpx;
}

.truck-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.truck-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.2);
}

/* 车次头部 */
.truck-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.truck-no {
  font-size: 32rpx;
  font-weight: bold;
  color: #1890FF;
}

.truck-date {
  font-size: 24rpx;
  color: #999;
}

/* 车次主体 */
.truck-body {
  margin-bottom: 24rpx;
}

.truck-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.info-label {
  color: #666;
  min-width: 80rpx;
}

.info-value {
  color: #333;
  font-weight: 500;
  margin-right: 16rpx;
}

.info-divider {
  color: #E0E0E0;
  margin: 0 16rpx;
}

/* 车次底部 */
.truck-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 2rpx solid #F0F0F0;
}

.amount-info {
  display: flex;
  flex-direction: column;
}

.amount-label {
  font-size: 24rpx;
  color: #999;
}

.amount-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4D4F;
  margin-top: 8rpx;
}

.btn-delete {
  padding: 12rpx 32rpx;
  background-color: #FF4D4F;
  color: #FFFFFF;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
}

.truck-actions {
  display: flex;
  gap: 8rpx;
}

.btn-edit {
  padding: 6rpx 16rpx;
  background-color: #FA8C16;
  color: white;
  border-radius: 8rpx;
  font-size: 22rpx;
  height: 48rpx;
  line-height: 36rpx;
  min-width: 60rpx;
  border: none;
}

.btn-small {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  height: 48rpx;
  line-height: 36rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 32rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: 300;
}
