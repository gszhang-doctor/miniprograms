/* 分红页面样式 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 20rpx;
}

.project-list {
  padding: 20rpx 24rpx;
}

.project-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.project-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.project-date {
  font-size: 24rpx;
  color: #999;
}

.card-body {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.info-label {
  color: #666;
  min-width: 100rpx;
}

.info-value {
  color: #333;
  font-weight: 500;
  flex: 1;
}

.info-unit {
  color: #999;
  font-size: 24rpx;
  margin-left: 8rpx;
}

.primary-color {
  color: #1890FF;
}

.card-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F0F0;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  border-radius: 12rpx;
  margin: 0 8rpx;
  transition: all 0.3s;
  position: relative;
}

.action-foreman {
  background: linear-gradient(135deg, #FA8C16 0%, #FFA940 100%);
}

.action-driver {
  background: linear-gradient(135deg, #FF4D4F 0%, #FF7875 100%);
}

.action-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.action-label {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-top: 8rpx;
  font-weight: 500;
}

.status-tag.paid {
  background-color: #F6FFED;
  color: #52C41A;
  border: 1rpx solid #B7EB8F;
}

.status-tag.unpaid {
  background-color: #FFF7E6;
  color: #FA8C16;
  border: 1rpx solid #FFD591;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.hint {
  font-size: 24rpx;
  margin-top: 8rpx;
}
