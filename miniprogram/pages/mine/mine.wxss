/* 我的页面样式 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 20rpx;
}

.header-card {
  background: linear-gradient(135deg, #1890FF 0%, #40A9FF 100%);
  margin: 20rpx 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  color: #FFFFFF;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-right: 32rpx;
}

.user-info {
  flex: 1;
}

.user-info.editing {
  display: flex;
  flex-direction: column;
}

.user-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-name.placeholder {
  font-size: 28rpx;
  opacity: 0.7;
  font-weight: normal;
}

.edit-hint {
  font-size: 22rpx;
  opacity: 0.6;
}

.name-input {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.edit-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.action-btn.cancel {
  background-color: rgba(255, 255, 255, 0.3);
}

.action-btn.save {
  background-color: #FFFFFF;
  color: #1890FF;
  font-weight: bold;
}

.function-list {
  margin: 0 24rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.function-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 2rpx solid #F0F0F0;
  transition: all 0.3s;
}

.function-item:last-child {
  border-bottom: none;
}

.function-item:active {
  background-color: #F5F7FA;
}

.function-item.danger:active {
  background-color: #FFF1F0;
}

.function-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.function-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.function-item.danger .function-text {
  color: #FF4D4F;
}

.function-arrow {
  font-size: 40rpx;
  color: #D9D9D9;
}

.tips {
  margin: 32rpx 24rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #999;
  line-height: 40rpx;
  margin-bottom: 8rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}
