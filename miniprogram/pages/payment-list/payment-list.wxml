<!-- 付款列表页面 -->
<wxs module="utils">
var getMethodIcon = function(method) {
  var icons = {
    '现金': '💵',
    '微信': '💬',
    '支付宝': '💳',
    '银行转账': '🏦'
  };
  return icons[method] || '💰';
};
module.exports.getMethodIcon = getMethodIcon;
</wxs>

<view class="container">
  <!-- 顶部信息 -->
  <view class="header">
    <view class="header-title">付款管理</view>
  </view>

  <!-- 财务统计 -->
  <view class="stats-card" wx:if="{{stats}}">
    <view class="stats-title">财务统计</view>
    <view class="stats-row">
      <view class="stats-item">
        <text class="stats-label">总金额</text>
        <text class="stats-value primary-color">¥{{stats.totalAmount}}</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-label">已付款</text>
        <text class="stats-value success-color">¥{{stats.paidAmount}}</text>
      </view>
    </view>
    <view class="stats-row" style="margin-top: 32rpx;">
      <view class="stats-item">
        <text class="stats-label">未付款</text>
        <text class="stats-value warning-color">¥{{stats.unpaidAmount}}</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-label">付款进度</text>
        <text class="stats-value">{{stats.progress}}%</text>
      </view>
    </view>
    <!-- 进度条 -->
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{stats.progress}}%"></view>
    </view>
  </view>

  <!-- 付款记录列表 -->
  <view class="payment-list">
    <view class="section-title">付款记录</view>

    <block wx:if="{{payments.length > 0}}">
      <view
        class="payment-card"
        wx:for="{{payments}}"
        wx:key="paymentId"
      >
        <view class="payment-header">
          <view class="payment-method">
            <text class="method-icon">{{utils.getMethodIcon(item.paymentMethod)}}</text>
            <text class="method-text">{{item.paymentMethod}}</text>
          </view>
          <view class="payment-date">{{item.paymentDate}}</view>
        </view>

        <view class="payment-body">
          <view class="amount-row">
            <text class="amount-label">付款金额</text>
            <text class="amount-value success-color">¥{{item.amount}}</text>
          </view>
          <view class="remark-row" wx:if="{{item.remarks}}">
            <text class="remark-label">备注：</text>
            <text class="remark-text">{{item.remarks}}</text>
          </view>
          <view class="remark-row" wx:if="{{item.creator}}">
            <text class="remark-label">创建者：</text>
            <text class="remark-text">{{item.creator}}</text>
          </view>
          <!-- 显示图片 -->
          <view class="payment-images" wx:if="{{item.images && item.images.length > 0}}">
            <view class="images-label">凭证图片：</view>
            <scroll-view class="images-scroll" scroll-x>
              <view class="images-wrapper">
                <image
                  class="payment-image"
                  src="{{img}}"
                  mode="aspectFill"
                  wx:for="{{item.images}}"
                  wx:for-item="img"
                  wx:key="index"
                  bindtap="previewImage"
                  data-images="{{item.images}}"
                  data-current="{{img}}"
                />
              </view>
            </scroll-view>
          </view>
        </view>

        <view class="payment-footer">
          <text class="payment-time">创建时间：{{item.createTime}}</text>
          <button
            class="btn-delete"
            bindtap="deletePayment"
            data-payment-id="{{item.paymentId}}"
          >
            删除
          </button>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text class="empty-icon">💳</text>
      <text>暂无付款记录</text>
      <text class="hint">点击右下角 + 新建付款记录</text>
    </view>
  </view>

  <!-- 添加按钮组 -->
  <view class="fab-group">
    <view class="fab fab-debt" bindtap="addDebt">
      <text class="fab-icon">欠</text>
    </view>
    <view class="fab" bindtap="addPayment">
      <text class="fab-icon">+</text>
    </view>
  </view>
</view>
