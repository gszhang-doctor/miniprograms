/* 全局样式 - 蓝白配色 */
page {
  background-color: #F5F7FA;
  color: #333;
  font-size: 28rpx;
}

/* 主色调 */
.primary-color {
  color: #1890FF;
}

.primary-bg {
  background-color: #1890FF;
}

/* 次要色调 */
.secondary-color {
  color: #52C41A;
}

.warning-color {
  color: #FAAD14;
}

.danger-color {
  color: #FF4D4F;
}

.info-color {
  color: #1890FF;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  transition: all 0.3s;
}

.btn-primary {
  background-color: #1890FF;
  color: #FFFFFF;
}

.btn-success {
  background-color: #52C41A;
  color: #FFFFFF;
}

.btn-warning {
  background-color: #FAAD14;
  color: #FFFFFF;
}

.btn-outline {
  border: 2rpx solid #1890FF;
  color: #1890FF;
  background-color: transparent;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

/* 输入框样式 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.form-label.required::after {
  content: '*';
  color: #FF4D4F;
  margin-left: 8rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus {
  background-color: #FFFFFF;
  border: 2rpx solid #1890FF;
}

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.tag-success {
  background-color: #F6FFED;
  color: #52C41A;
  border: 1rpx solid #B7EB8F;
}

.tag-warning {
  background-color: #FFFBE6;
  color: #FAAD14;
  border: 1rpx solid #FFE58F;
}

.tag-info {
  background-color: #E6F7FF;
  color: #1890FF;
  border: 1rpx solid #91D5FF;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background-color: #F0F0F0;
  margin: 32rpx 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}
